{
  "manifest_version": "1.0.0",
  "project": "CRIBA_BLACKFORGE",
  "active_phase": "P2",
  "master_spec": "spec/CRIBA_BLACKFORGE_MASTER_SPEC.md",
  "phase_spec": "docs/phases/P2_PERSONA_SYSTEM_EXECUTABLE.md",
  "verdicts": [
    "VERIFIED",
    "PARTIAL",
    "BLOCKED",
    "FAILED",
    "INFRA_ERROR"
  ],
  "scope": {
    "allowed_application_paths": [
      "src/criba/personas.py",
      "tests/unit/test_personas.py",
      "docs/phases/P2_*",
      "artifacts/hy3/*"
    ],
    "allowed_infrastructure_paths": [
      ".autoregen/cloud/*",
      "scripts/modal-*",
      "scripts/start-hermes-*",
      "scripts/run-modal-*",
      "schemas/*"
    ],
    "forbidden_phase_paths": [
      "src/criba/ensemble.py",
      "src/criba/chain.py",
      "src/criba/adversarial.py",
      "src/criba/blackforge_extended.py",
      "src/criba/logging.py",
      "src/criba/latency.py",
      "src/criba/metrics.py"
    ]
  },
  "gates": [
    {
      "gate_id": "environment",
      "severity": "critical",
      "command": [
        "python",
        "-c",
        "import platform,sys; print(sys.version); print(platform.platform())"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": true
    },
    {
      "gate_id": "p2_tests",
      "severity": "critical",
      "command": [
        "python",
        "-m",
        "pytest",
        "tests/unit/test_personas.py",
        "-q",
        "--junitxml=/artifacts/current/p2-junit.xml"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": true
    },
    {
      "gate_id": "full_regression",
      "severity": "critical",
      "command": [
        "python",
        "-m",
        "pytest",
        "tests/unit",
        "-q",
        "--junitxml=/artifacts/current/full-junit.xml"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": true
    },
    {
      "gate_id": "mypy_p2",
      "severity": "critical",
      "command": [
        "python",
        "-m",
        "mypy",
        "src/criba/personas.py",
        "--strict"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": true
    },
    {
      "gate_id": "ruff_p2",
      "severity": "high",
      "command": [
        "python",
        "-m",
        "ruff",
        "check",
        "src/criba/personas.py",
        "tests/unit/test_personas.py"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": true
    },
    {
      "gate_id": "coverage_p2",
      "severity": "high",
      "command": [
        "python",
        "-m",
        "pytest",
        "tests/unit/test_personas.py",
        "--cov=src/criba/personas.py",
        "--cov-branch",
        "--cov-report=xml:/artifacts/current/p2-coverage.xml",
        "--cov-report=json:/artifacts/current/p2-coverage.json",
        "-q"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": true
    },
    {
      "gate_id": "property_p2",
      "severity": "high",
      "command": [
        "python",
        "-m",
        "pytest",
        "tests/property/test_personas_properties.py",
        "-q"
      ],
      "pass_exit_codes": [
        0,
        5
      ],
      "required": false,
      "blocked_if_missing": "tests/property/test_personas_properties.py"
    },
    {
      "gate_id": "adversarial_p2",
      "severity": "critical",
      "command": [
        "python",
        "-m",
        "pytest",
        "tests/adversarial/test_personas_adversarial.py",
        "-q"
      ],
      "pass_exit_codes": [
        0,
        5
      ],
      "required": false,
      "blocked_if_missing": "tests/adversarial/test_personas_adversarial.py"
    },
    {
      "gate_id": "mutation_p2",
      "severity": "high",
      "command": [
        "bash",
        "-lc",
        "python -m mutmut run --paths-to-mutate src/criba/personas.py --tests-dir tests/unit/test_personas.py; python -m mutmut results"
      ],
      "pass_exit_codes": [
        0
      ],
      "required": false,
      "blocked_if_missing": "src/criba/personas.py",
      "note": "Mutation testing runs on Modal Linux (mutmut has no native Windows support). No CRITICAL/HIGH survivors allowed."
    },
    {
      "gate_id": "scope_guard",
      "severity": "critical",
      "builtin": "scope_guard",
      "required": true
    },
    {
      "gate_id": "feature_flags",
      "severity": "critical",
      "builtin": "feature_flags",
      "required": true
    },
    {
      "gate_id": "determinism",
      "severity": "critical",
      "builtin": "determinism",
      "required": true,
      "repetitions": 3
    },
    {
      "gate_id": "hy3_review",
      "severity": "critical",
      "builtin": "hy3_review",
      "required": true,
      "review_path": "artifacts/hy3/P2_REVIEW.json"
    }
  ],
  "verified_requires": {
    "all_required_gates_pass": true,
    "critical_failures": 0,
    "high_failures": 0,
    "hy3_review_valid": true,
    "forbidden_phase_files_created": 0,
    "feature_flags_default_off": true
  }
}
