  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "xl": 20
  },
  "spacing": {
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "20": 20,
    "24": 24,
    "32": 32
  },
  "shadow": {
    "sm": "0 1px 3px rgba(0,0,0,0.45)",
    "md": "0 4px 16px rgba(0,0,0,0.55)",
    "glow_1": {
      "blur": 12,
      "color": "rgba(34,211,238,0.28)",
      "note": "elemento activo/hover destacado; via QGraphicsDropShadowEffect"
    },
    "glow_2": {
      "blur": 24,
      "color": "rgba(139,92,246,0.38)",
      "note": "SOLO el gauge value_score"
    }
  },
  "typography": {
    "family": "\"Inter\", \"Segoe UI Variable\", \"Segoe UI\", sans-serif",
    "display": { "size_px": 28, "weight": 800 },
    "h1": { "size_px": 22, "weight": 700 },
    "h2": { "size_px": 17, "weight": 700 },
    "h3": { "size_px": 14, "weight": 600 },
    "body": { "size_px": 13, "weight": 400 },
    "caption": { "size_px": 11, "weight": 500 },
    "numbers": "tabular (tnum); hora e IDs pueden usar monoespaciada"
  },
  "icon": {
    "size": {
      "sm": 16,
      "md": 20,
      "lg": 28
    },
    "style": "lineal, stroke 1.5-2px, un solo set"
  },
  "layout": {
    "sidebar_width": 232,
    "sidebar_width_min": 208,
    "topbar_height": 72,
    "right_column_width": 340,
    "right_column_width_min": 300,
    "footer_height": 36,
    "gutter": 16,
    "outer_margin": 20,
    "nav_button_height": 54,
    "table_row_height": 44,
    "gauge_diameter": 160,
    "resolutions_target": ["1360x768", "1680x1050"]
  }
