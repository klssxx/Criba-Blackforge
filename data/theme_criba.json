{
  "$schema_note": "CRIBA visual contract tokens v1.0.0 (2026-07-23). Fuente unica de verdad para colores, radios, espaciado, sombras, tipografia e iconos. Los docs en docs/*_CRIBA.md explican el uso. Si divergen, manda este JSON.",
  "version": "1.0.0",
  "color": {
    "bg": {
      "app": "#070D1A",
      "panel": "#0B1424",
      "card": "#101D33",
      "card_hover": "#16263F",
      "inset": "#0A1526"
    },
    "border": {
      "soft": "#1E3355",
      "active": "#22D3EE"
    },
    "text": {
      "primary": "#EAF2FF",
      "secondary": "#9FB3D1",
      "muted": "#64748B"
    },
    "accent": {
      "blue": "#3B82F6",
      "cyan": "#22D3EE",
      "violet": "#8B5CF6"
    },
    "success": "#10B981",
    "warning": "#F59E0B",
    "error": "#EF4444",
    "chart": {
      "1": "#22D3EE",
      "2": "#8B5CF6",
      "3": "#3B82F6",
      "4": "#EC4899",
      "5": "#64748B"
